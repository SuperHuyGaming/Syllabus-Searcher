# --- AWS DynamoDB (course catalog) ---
TABLE_NAME=SyllabusSearcher
AWS_REGION=us-east-1
# Local dev only: point at DynamoDB Local from docker-compose. Leave unset in AWS.
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- MongoDB Atlas M0 (syllabus files in GridFS) ---
# docker-compose maps MongoDB to 27018 so it doesn't clash with other local Mongo instances
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB=syllabus_searcher

# --- Supabase (upload review queue + admin login) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to approve uploads
ADMIN_EMAILS=you@gmu.edu

# --- Azure AI Document Intelligence, F0 free tier (optional) ---
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- Security ---
# CloudFront sends this as the X-Origin-Secret header so the Lambda URL can't be hit directly.
# Leave empty locally.
ORIGIN_SECRET=
# Salt for hashing uploader IPs before they are stored
IP_HASH_SALT=change-me
UPLOADS_PER_HOUR=5

PORT=3001
