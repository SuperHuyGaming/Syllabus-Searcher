# Copy to .env for `docker compose up`. Everything here is optional:
# without Supabase, searching and viewing syllabi still work, but uploads and /admin don't.

# Supabase (free tier): Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@gmu.edu

# Azure AI Document Intelligence, F0 free tier (optional)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# AI check of uploads (optional, free tiers only). Gemini key: aistudio.google.com/apikey.
# Groq key (fallback when Gemini fails or runs out of quota): console.groq.com/keys.
# Empty models use the defaults in api/src/lib/ai.js.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=

IP_HASH_SALT=change-me
UPLOADS_PER_HOUR=5
